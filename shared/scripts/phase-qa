#!/usr/bin/env bash
# The QA pass at the end of a parallel run: the finished work is used the way
# a real user would, what is found is fixed once, each fix is re-checked once,
# and the rest goes into the report. This script owns the pass's state, so a
# controller that lost its place cannot run a stage twice.
#
# The pass works in the run's integration worktree,
# <main>/.worktrees/integration, on the QA branch phase-qa-<run>, where <run>
# is the run directory's name: two runs in one repository never share it.
# Fixes are committed there and reach base only through 'land', after the
# ledger shows the integration verifier passed exactly that commit.
#
# Subcommands:
#   open      put the integration worktree on the QA branch at the base tip
#             (created, or re-attached with tracked changes discarded; a
#             branch that holds no fix yet follows base), record
#             'qa: opened — <branch> at <sha>', print 'opened <sha>'
#   next      print the one action the ledger allows next; write nothing
#   close     append 'qa: done — <summary>', counted from the ledger, and
#             print it
#   land SHA  fast-forward base to the QA branch in the main checkout, only
#             when the ledger's last 'qa: verified' line passed exactly SHA;
#             record 'qa: landed (<sha>)', push base, leave the integration
#             worktree on the base tip, detached, and delete the QA branch.
#             Checks run before anything moves. Re-run after an interruption,
#             it finishes the landing
#   push      push the QA branch as a backup of fixes that did not land; a
#             failed push is recorded, never fatal (as phase-push)
#   report    print the QA block of the run's report, from the ledger and
#             the index lines of the pass's files; write nothing. A missing
#             file or line never fails it: the id is printed without a title
#   status    print the pass's stage for the status line, '<stage>' or
#             '<stage><TAB><done><TAB><total>', or nothing when no pass is
#             active; write nothing, always exit 0
#
# The ledger lines of the pass, written by this script and the controller:
#   run: qa scope — <none|top N|all|focus: words>
#   qa: opened — <branch> at <sha>
#   qa: flows defined — <n> found, selected <list>, not walkable <list>, parallel <yes|no>
#   qa flow <F>: walked — <n> findings
#   qa flow <F>: not walked — <why>
#   qa: triaged — <n> findings, fix <G1@2 G3@2,5 …|->, <n> spec, <n> outside this run
#   qa group <G>: fixed <sha>
#   qa group <G>: not fixed — <reason>
#   qa: verified PASS — <sha>
#   qa: verified FAIL — <reason>
#   qa: landed (<sha>)
#   qa: not landed — <reason>
#   qa flow <F>: rechecked — G1 confirmed, G3 still broken, <n> new
#   qa: done — <summary>
#   qa: skipped — <reason>
# The index lines 'report' reads, each file's first lines:
#   <run-dir>/qa-flows.md             - [selected] F2 — checkout
#                                     - [not walkable] F4 — share sheet: <why>
#                                     - [not selected] F6 — export
#   <run-dir>/qa-triage.md            - [fix] G1 — checkout: <one line> (broken|minor)
#                                     - [spec] G4 — refunds: <one line> — proposed: <change>
#                                     - [outside this run] G5 — <one line>
#   <run-dir>/qa-flow-<F>-recheck.md  - [new] <one line>
# Lists are comma-separated numbers, or '-'; spaces after the commas are
# ignored. In the triaged line each fix group names the flows its findings
# came from, in fix order. '<role> dispatched' lines are progress markers and
# never change what comes next.
#
# 'next' prints the first of these that applies. A 'qa: skipped' line is
# superseded when a 'batch <K>: landed', 'run: final check' or 'run: qa scope'
# line follows it: what the skip was decided on has changed. QA lines up to
# the last superseded skip are ignored.
#    1  no scope recorded, or scope 'none'            done
#    2  'qa: done' recorded                           done
#    3  a skip that is not superseded                 done
#    4  no flows defined, a requested phase is not
#       merged                                        skip phase <N> did not land
#    5  no flows defined, the last final check failed skip the final check failed
#    6  no flows defined, no 'opened' line since the
#       last landed batch                             open
#    7  no flows defined                              plan
#    8  a batch landed after the flows were defined   close
#    9  selected, walkable flows without an outcome   walk <F> [<F>…]
#   10  not triaged, no findings                      close
#   11  not triaged                                   triage
#   12  a fix group without an outcome                fix <G>
#   13  no group was fixed                            close
#   14  gates failed or the landing was refused, and
#       the QA branch is not pushed since             push
#   15  gates failed or the landing was refused       close
#   16  not verified                                  verify <sha of the last fix>
#   17  not landed                                    land <verified sha>
#   18  flows of fixed groups not re-checked          recheck <F> [<F>…]
#   19  otherwise                                     close
# With 'parallel no', walk and recheck name one flow at a time. Like
# phase-schedule, next prints an action whether or not its agent is already
# out. Every stage has one outcome line and no rule leads back to a stage
# that has one: that is what bounds the pass to one round.
#
# Exit codes:
#   0   done
#   2   usage error, or no ledger
#   11  land: main checkout not clean
#   13  land: main checkout is not on BASE
#   14  open: the QA branch exists and the ledger does not account for it
#   17  open: a batch is still open; close: 'qa: done' is already recorded;
#       land: the ledger already records the landing
#   18  close: the pass is not over; land, push: the QA branch does not exist
#   19  land: SHA is not a commit, or the QA branch is not at it
#   20  land: the fast-forward failed; base unchanged
#   21  land: base moved past what the QA branch was built on
#   22  land: the ledger does not show SHA as verified
#
# Usage: phase-qa DESIGN_DOC BASE open|next|close|push|report|status
#        phase-qa DESIGN_DOC BASE land SHA
set -euo pipefail

usage() {
  echo "usage: phase-qa DESIGN_DOC BASE open|next|close|push|report|status" >&2
  echo "       phase-qa DESIGN_DOC BASE land SHA" >&2
  exit 2
}

[ "$#" -ge 3 ] || usage
doc=$1
base=$2
sub=$3
shift 3
case "$sub" in
  open | next | close | push | report | status) [ "$#" -eq 0 ] || usage ;;
  land) [ "$#" -eq 1 ] || usage ;;
  *) usage ;;
esac
# The status line calls 'status' on every refresh: whatever goes wrong, it
# prints nothing more and exits 0.
if [ "$sub" = status ]; then
  exec 2>/dev/null
  trap 'exit 0' EXIT
fi

here=$(cd "$(dirname "$0")" && pwd)
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  echo "not inside a git repository: cd to the repository the phases land in" >&2
  exit 2
fi
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
wt="$main/.worktrees/integration"
rundir=$("$here/phase-run-dir" "$doc")
ledger="$rundir/run.md"
branch="phase-qa-$(basename "$rundir")"
if [ ! -f "$ledger" ]; then
  echo "no ledger at $ledger: run phase-preflight first" >&2
  exit 2
fi

open_batch() { # the open batch's number, if any
  "$here/phase-state" "$doc" | awk -F'\t' '
    $1 == "batch" && ($3 == "open" || $3 == "conflict" || $3 == "built" || $3 == "landable") { print $2 }'
}
branch_exists() {
  git -C "$main" show-ref --verify --quiet "refs/heads/$branch"
}
registered() {
  git worktree list --porcelain | grep -qx "worktree $1"
}
ensure_worktree() {
  if ! { registered "$wt" && [ -d "$wt" ]; }; then
    git worktree prune
    mkdir -p "$main/.worktrees"
    printf '*\n' > "$main/.worktrees/.gitignore"
    git worktree add -q --detach "$wt" "$base" >&2
  fi
}
# Nothing uncommitted in the integration worktree is anyone's work: walkers
# and verifiers commit nothing, and a fixer that was interrupted starts over
# from the branch tip.
reset_tracked() {
  if [ -n "$(git -C "$wt" status --porcelain --untracked-files=no)" ]; then
    git -C "$wt" reset -q --hard
  fi
}

# The lowest requested phase that is not merged, if any.
unmerged_phase() {
  local range state n
  range=$(sed -n '2s/^# base: .*  requested: //p' "$ledger")
  state=$("$here/phase-state" "$doc")
  for n in $("$here/parse-phases" "$doc" "$range" | cut -f1); do
    if ! printf '%s\n' "$state" | awk -F'\t' -v n="$n" '$1 == n && $2 == "merged" { f = 1 } END { exit !f }'; then
      echo "$n"
      return 0
    fi
  done
}

# One reading of the ledger for every subcommand. MODE picks what is printed:
# 'next' the action, 'status' the stage, 'close' the summary of the done line,
# 'report' the report block. Only the ledger is read as a ledger: the pass's
# own files, given after it for 'report', contribute their index lines.
# shellcheck disable=SC2016 # an awk program, not a shell string
PARSE='
  function clean(s) { gsub(/[ \t]/, "", s); return (s == "-") ? "" : s }
  function between(s, a, b,   i, j, t) {
    i = index(s, a)
    if (!i) return ""
    t = substr(s, i + length(a))
    if (b == "") return t
    j = index(t, b)
    return j ? substr(t, 1, j - 1) : t
  }
  function lastword(s,   k, w) { k = split(s, w, " "); return w[k] }
  function sortnum(arr, cnt,   a, b, v) {
    for (a = 2; a <= cnt; a++) {
      v = arr[a]; b = a - 1
      while (b >= 1 && arr[b] + 0 > v + 0) { arr[b + 1] = arr[b]; b-- }
      arr[b + 1] = v
    }
  }
  FILENAME != ledgerfile {
    if ($0 ~ /^- \[/) indexline()
    next
  }
  function indexline(   kind, rest, f, g, t, i, sev) {
    kind = $0; sub(/^- \[/, "", kind); sub(/\].*$/, "", kind)
    rest = $0; sub(/^- \[[^]]*\] */, "", rest)
    if (FILENAME ~ /qa-flows\.md$/) {
      if (rest !~ /^F[0-9]+/) return
      f = rest; sub(/^F/, "", f); sub(/[^0-9].*$/, "", f)
      t = rest; sub(/^F[0-9]+ *(— *)?/, "", t)
      if (kind == "not walkable" && (i = index(t, ": "))) { fwhyidx[f] = substr(t, i + 2); t = substr(t, 1, i - 1) }
      ftitle[f] = t
      if (kind == "not selected") unselected[++nunselected] = f
    }
    else if (FILENAME ~ /qa-triage\.md$/) {
      if (rest !~ /^G[0-9]+/) return
      g = rest; sub(/^G/, "", g); sub(/[^0-9].*$/, "", g)
      t = rest; sub(/^G[0-9]+ *(— *)?/, "", t)
      if (t ~ / \((broken|minor)\)$/) {
        sev = t; sub(/^.* \(/, "", sev); sub(/\)$/, "", sev)
        sub(/ \((broken|minor)\)$/, "", t)
        gsev[g] = sev
      }
      gtext[g] = t
      if (kind == "spec") speclist[++nspeclist] = g
    }
    else if (FILENAME ~ /-recheck\.md$/ && kind == "new") {
      f = FILENAME; sub(/^.*qa-flow-/, "", f); sub(/-recheck\.md$/, "", f)
      newline[++nnewline] = "flow " f ": " rest
    }
  }
  /^run: qa scope — / { scope = $0; sub(/^run: qa scope — /, "", scope); scopenr = NR; next }
  /^run: final check / {
    if ($0 !~ / dispatched$/) { finalnr = NR; finalfail = ($0 ~ /^run: final check FAIL/) }
    next
  }
  /^batch [0-9]+: landed/ { landnr = NR; next }
  index($0, "push: " branch " ") == 1 { pushnr = NR; next }
  /^qa: / || /^qa flow [0-9]+: / || /^qa group [0-9]+: / {
    if ($0 !~ / dispatched$/) { q[++qn] = $0; qnr[qn] = NR }
    next
  }
  function read(   i, l, nr, body, f, g, t, n, j, tok, c) {
    epoch = 0
    for (i = 1; i <= qn; i++)
      if (q[i] ~ /^qa: skipped/ && (landnr > qnr[i] || finalnr > qnr[i] || scopenr > qnr[i])) epoch = qnr[i]
    for (i = 1; i <= qn; i++) {
      if (qnr[i] <= epoch) continue
      l = q[i]; nr = qnr[i]
      if (l ~ /^qa: opened — /) { openednr = nr; openedsha = lastword(l) }
      else if (l ~ /^qa: skipped/) { skipped = 1; skipreason = l; sub(/^qa: skipped — /, "", skipreason) }
      else if (l ~ /^qa: flows defined — /) {
        flowsnr = nr
        body = l; sub(/^qa: flows defined — /, "", body)
        found = body + 0
        nsel = split(clean(between(body, ", selected ", ", not walkable ")), sel, ",")
        n = split(clean(between(body, ", not walkable ", ", parallel ")), t, ",")
        for (j = 1; j <= n; j++) if (t[j] != "") unwalkable[t[j]] = 1
        parallel = clean(between(body, ", parallel ", ""))
      }
      else if (l ~ /^qa flow [0-9]+: /) {
        f = l; sub(/^qa flow /, "", f); sub(/:.*$/, "", f)
        body = l; sub(/^qa flow [0-9]+: /, "", body)
        if (body ~ /^walked — /) {
          c = body; sub(/^walked — /, "", c)
          if (!(f in fout)) nwalked++
          fout[f] = "walked"; findings += c + 0
        }
        else if (body ~ /^not walked/) { fout[f] = "not"; fwhy[f] = body; sub(/^not walked — /, "", fwhy[f]) }
        else if (body ~ /^rechecked — /) {
          rechecked[f] = 1
          sub(/^rechecked — /, "", body)
          n = split(body, t, /, */)
          for (j = 1; j <= n; j++) {
            tok = t[j]
            if (tok ~ /^G[0-9]+ confirmed/) { g = tok; sub(/^G/, "", g); sub(/ .*$/, "", g); confirmed[g] = 1 }
            else if (tok ~ /^G[0-9]+ still broken/) { g = tok; sub(/^G/, "", g); sub(/ .*$/, "", g); broken[g] = 1 }
            else if (tok ~ /^[0-9]+ new/) newcount += tok + 0
          }
        }
      }
      else if (l ~ /^qa: triaged — /) {
        triaged = 1
        body = l; sub(/^qa: triaged — /, "", body)
        t[1] = between(body, ", fix ", " spec")
        speccount = lastword(t[1]) + 0
        sub(/, *[0-9]+$/, "", t[1])
        gsub(/, +/, ",", t[1])
        outside = between(body, " spec, ", "") + 0
        n = split(t[1], tok_, " ")
        for (j = 1; j <= n; j++) {
          if (tok_[j] !~ /^G[0-9]+@/) continue
          g = tok_[j]; sub(/^G/, "", g); sub(/@.*$/, "", g)
          f = tok_[j]; sub(/^G[0-9]+@/, "", f)
          group[++ngroups] = g; gflows[g] = f
        }
      }
      else if (l ~ /^qa group [0-9]+: /) {
        g = l; sub(/^qa group /, "", g); sub(/:.*$/, "", g)
        body = l; sub(/^qa group [0-9]+: /, "", body)
        if (body ~ /^fixed /) { gout[g] = "fixed"; lastfix = lastword(body) }
        else if (body ~ /^not fixed/) { gout[g] = "not"; greason[g] = body; sub(/^not fixed — /, "", greason[g]) }
      }
      else if (l ~ /^qa: verified PASS/) { verdict = "PASS"; vsha = lastword(l) }
      else if (l ~ /^qa: verified FAIL/) { verdict = "FAIL"; failnr = nr }
      else if (l ~ /^qa: landed \(/) landed = 1
      else if (l ~ /^qa: not landed/) { notlanded = 1; failnr = nr }
      else if (l ~ /^qa: done/) { done = 1; doneline = l }
    }
    # What is left to walk, fix and re-check.
    for (i = 1; i <= nsel; i++) {
      f = sel[i]
      if (f == "" || (f in unwalkable)) continue
      walkable++
      if (f in fout) walkdone++
      else towalk[++ntowalk] = f
    }
    for (i = 1; i <= ngroups; i++) {
      g = group[i]
      if (gout[g] == "fixed") {
        nfixed++
        n = split(gflows[g], t, ",")
        for (j = 1; j <= n; j++) if (t[j] != "" && !(t[j] in rflow)) { rflow[t[j]] = 1; rlist[++nrlist] = t[j] }
      }
      else if (gout[g] == "not") nnotfixed++
      else if (nextgroup == "") nextgroup = g
    }
    sortnum(rlist, nrlist)
    for (i = 1; i <= nrlist; i++) {
      if (rlist[i] in rechecked) recheckdone++
      else torecheck[++ntorecheck] = rlist[i]
    }
    unlanded = (verdict == "FAIL" || notlanded)
  }
  function flowlist(arr, cnt,   i, out) {
    if (parallel == "no") return arr[1]
    for (i = 1; i <= cnt; i++) out = out (i > 1 ? " " : "") arr[i]
    return out
  }
  # Sets action, and stage with its progress, by the rules in the header.
  function decide() {
    stage = ""
    if (scope == "" || scope == "none") { action = "done"; return }
    if (done) { action = "done"; return }
    if (skipped) { action = "done"; return }
    if (!flowsnr) {
      if (unmerged != "") { action = "skip phase " unmerged " did not land"; return }
      if (finalfail) { action = "skip the final check failed"; return }
      if (openednr) stage = "planning"
      action = (openednr > landnr + 0) ? "plan" : "open"
      return
    }
    if (landnr > flowsnr) { action = "close"; abandoned = 1; return }
    if (ntowalk) { action = "walk " flowlist(towalk, ntowalk); stage = "walking\t" (walkdone + 0) "\t" walkable; return }
    if (!triaged) {
      if (findings + 0 == 0) { action = "close"; return }
      action = "triage"; stage = "triaging"; return
    }
    if (nextgroup != "") {
      action = "fix " nextgroup; stage = "fixing\t" (nfixed + nnotfixed + 0) "\t" ngroups; return
    }
    if (!nfixed) { action = "close"; return }
    if (unlanded) { action = (pushnr > failnr) ? "close" : "push"; return }
    if (verdict == "") { action = "verify " lastfix; stage = "verifying"; return }
    if (!landed) { action = "land " vsha; stage = "landing"; return }
    if (ntorecheck) {
      action = "recheck " flowlist(torecheck, ntorecheck)
      stage = "rechecking\t" (recheckdone + 0) "\t" nrlist; return
    }
    action = "close"
  }
  function summary(   i, g, c, b, out) {
    if (abandoned) return "abandoned, base moved under the pass"
    if (!nwalked) return "nothing to walk"
    if (!triaged) return nwalked " flows walked, no findings"
    if (!unlanded)
      for (i = 1; i <= ngroups; i++) {
        g = group[i]
        if (gout[g] != "fixed") continue
        if (g in broken) b++
        else if (g in confirmed) c++
      }
    out = (c + 0) " confirmed, " (b + 0) " still broken, " (nnotfixed + 0) " not fixed, " (newcount + 0) " new, " (speccount + 0) " spec"
    if (unlanded && nfixed) out = out ", " nfixed " fixed but not landed"
    return out
  }
  function flowname(f) { return "flow " f ((f in ftitle) && ftitle[f] != "" ? " " ftitle[f] : "") }
  function groupline(g, suffix, withsev,   out) {
    out = "    G" g
    if ((g in gtext) && gtext[g] != "") out = out " " gtext[g]
    if (suffix != "") out = out " — " suffix
    if (withsev && (g in gsev)) out = out " (" gsev[g] ")"
    return out
  }
  function report(   i, f, g, n, list, cnt, pass, sev) {
    if (!flowsnr) {
      if (scope == "" || scope == "none") print "qa: not run — not requested"
      else if (skipped) print "qa: skipped — " skipreason
      else print "qa: not run"
      return
    }
    print "qa: " (nwalked + 0) " of " found " flows walked on " openedsha " (scope: " scope ")"
    cnt = 0
    for (i = 1; i <= nsel; i++) {
      f = sel[i]
      if (f == "") continue
      if (f in unwalkable) list[++cnt] = f
      else if (fout[f] == "not") list[++cnt] = f
    }
    sortnum(list, cnt)
    if (cnt) print "  not walked: " cnt
    for (i = 1; i <= cnt; i++) {
      f = list[i]
      if (f in unwalkable) print "    " flowname(f) " — " ((f in fwhyidx) ? fwhyidx[f] : "not walkable")
      else print "    " flowname(f) " — " fwhy[f]
    }
    if (nunselected) {
      n = ""
      for (i = 1; i <= nunselected; i++) n = n (i > 1 ? ", " : "") flowname(unselected[i])
      print "  not selected: " n
    }
    if (unlanded && nfixed) {
      print "  fixed on " branch ", not landed: " nfixed
      for (i = 1; i <= ngroups; i++) if (gout[group[i]] == "fixed") print groupline(group[i], "", 0)
      if (verdict == "FAIL") print "    gates: " rundir "/qa-gates-evidence.md"
    }
    else {
      cnt = 0
      for (i = 1; i <= ngroups; i++) {
        g = group[i]
        if (gout[g] == "fixed" && (g in confirmed) && !(g in broken)) list[++cnt] = g
      }
      if (cnt) print "  fixed and confirmed: " cnt
      for (i = 1; i <= cnt; i++) print groupline(list[i], "", 0)
    }
    # Still open: broken ones first, then by group number.
    cnt = 0
    for (pass = 1; pass <= 2; pass++)
      for (i = 1; i <= ngroups; i++) {
        g = group[i]
        sev = (g in gsev) ? gsev[g] : ""
        if ((pass == 1) != (sev == "broken")) continue
        if (gout[g] == "not") open[++cnt] = groupline(g, "not fixed: " greason[g], 1)
        else if (gout[g] == "fixed" && !unlanded) {
          if (g in broken) open[++cnt] = groupline(g, "still broken after the fix", 1)
          else if (!(g in confirmed)) open[++cnt] = groupline(g, "fixed, not re-checked", 1)
        }
      }
    if (cnt) print "  still open: " cnt
    for (i = 1; i <= cnt; i++) print open[i]
    n = (newcount + 0 > nnewline + 0) ? newcount : nnewline
    if (n + 0) print "  new at re-check, not investigated: " n
    for (i = 1; i <= nnewline; i++) print "    " newline[i]
    if (speccount + 0) print "  spec questions, nothing changed: " speccount
    for (i = 1; i <= nspeclist; i++) print groupline(speclist[i], "", 0)
    if (outside + 0) print "  outside this run: " outside
    if (abandoned || doneline ~ /abandoned/) print "  abandoned: base moved under the pass"
    print "  details: " rundir "/qa-triage.md, " rundir "/qa-flows.md"
  }
  END {
    read()
    decide()
    if (mode == "next") print action
    else if (mode == "report") report()
    else if (mode == "status") { if (stage != "") print stage }
    else if (mode == "close") {
      if (done) print "!done"
      else if (action != "close") print "!open"
      else print summary()
    }
  }
'
compute() { # compute MODE
  awk -v mode="$1" -v branch="$branch" -v unmerged="$(unmerged_phase)" -v ledgerfile="$ledger" "$PARSE" "$ledger"
}

case "$sub" in
  land)
    verified=$1
    if [ "$(git -C "$main" branch --show-current)" != "$base" ]; then
      echo "main checkout $main is not on base '$base' (git switch $base)" >&2
      exit 13
    fi
    if [ -n "$(git -C "$main" status --porcelain)" ]; then
      echo "main checkout not clean: landing would carry unverified changes (git status)" >&2
      exit 11
    fi
    if grep -q '^qa: landed (' "$ledger"; then
      echo "the QA fixes are already recorded as landed; reconcile the ledger and git log" >&2
      exit 17
    fi
    if ! branch_exists; then
      echo "QA branch '$branch' does not exist" >&2
      exit 18
    fi
    if ! verified_sha=$(git -C "$main" rev-parse --verify --quiet "$verified^{commit}"); then
      echo "verified SHA '$verified' is not a commit in this repository" >&2
      exit 19
    fi
    if [ "$(git -C "$main" rev-parse "refs/heads/$branch")" != "$verified_sha" ]; then
      echo "QA branch '$branch' is not at the verified $(git -C "$main" rev-parse --short "$verified_sha"): verify it again before landing" >&2
      exit 19
    fi
    if ! git -C "$main" merge-base --is-ancestor "$base" "$verified_sha"; then
      echo "base '$base' moved past what '$branch' was built on: the QA fixes cannot land" >&2
      exit 21
    fi
    passed=$(grep '^qa: verified ' "$ledger" | tail -n 1 | sed -n 's/^qa: verified PASS — //p' | awk '{ print $1 }' || true)
    if [ -z "$passed" ] \
      || [ "$(git -C "$main" rev-parse --verify --quiet "$passed^{commit}" || true)" != "$verified_sha" ]; then
      echo "the ledger shows no passing gates for $(git -C "$main" rev-parse --short "$verified_sha"): verify the QA branch before landing" >&2
      exit 22
    fi
    # Re-run after an interruption, base may already be at the QA tip: the
    # fast-forward is skipped and only what the ledger lacks is recorded.
    if [ "$(git -C "$main" rev-parse HEAD)" != "$verified_sha" ]; then
      before=$(git -C "$main" rev-parse HEAD)
      if ! git -C "$main" merge -q --ff-only "$branch" >/dev/null 2>&1; then
        git -C "$main" reset -q --hard "$before"
        echo "fast-forward of '$base' to '$branch' failed; base unchanged" >&2
        exit 20
      fi
    fi
    short=$(git -C "$main" rev-parse --short HEAD)
    printf 'qa: landed (%s)\n' "$short" >> "$ledger"
    echo "qa landed on $base ($short)"
    "$here/phase-push" "$doc" "$base" base >/dev/null || true
    # The re-check walks the landed tree; the branch has served its purpose.
    if registered "$wt" && [ -d "$wt" ]; then
      reset_tracked
      git -C "$wt" switch -q --detach "refs/heads/$base"
    fi
    git -C "$main" branch -q -d "$branch" >/dev/null 2>&1 || true
    ;;
  push)
    if ! branch_exists; then
      echo "QA branch '$branch' does not exist" >&2
      exit 18
    fi
    short=$(git -C "$main" rev-parse --short "refs/heads/$branch")
    set +e
    err=$(GIT_TERMINAL_PROMPT=0 git -C "$main" push -q origin "refs/heads/$branch:refs/heads/$branch" 2>&1 </dev/null)
    rc=$?
    set -e
    if [ "$rc" -eq 0 ]; then
      line="push: $branch at $short"
    else
      reason=$(printf '%s\n' "$err" | grep -v '^ *$' | head -n 1 | sed 's/^error: //; s/^fatal: //')
      line="push: $branch failed — ${reason:-git push exited $rc}"
    fi
    printf '%s\n' "$line" >> "$ledger"
    printf '%s\n' "$line"
    ;;
  report)
    set -- "$ledger"
    for f in "$rundir/qa-flows.md" "$rundir/qa-triage.md" "$rundir"/qa-flow-*-recheck.md; do
      if [ -f "$f" ]; then set -- "$@" "$f"; fi
    done
    awk -v mode=report -v branch="$branch" -v unmerged="" -v ledgerfile="$ledger" -v rundir="$rundir" "$PARSE" "$@"
    ;;
  next) compute next ;;
  status) compute status ;;
  close)
    line=$(compute close)
    case "$line" in
      '!done')
        echo "the QA pass is already closed: the ledger has a 'qa: done' line" >&2
        exit 17
        ;;
      '!open')
        echo "the QA pass is not over: phase-qa next says '$(compute next)'" >&2
        exit 18
        ;;
    esac
    printf 'qa: done — %s\n' "$line" >> "$ledger"
    printf 'qa: done — %s\n' "$line"
    ;;
  open)
    ob=$(open_batch)
    if [ -n "$ob" ]; then
      echo "batch $ob is still open: land or fail it before the QA pass" >&2
      exit 17
    fi
    if branch_exists && ! grep -qF -- "qa: opened — $branch at " "$ledger"; then
      echo "branch '$branch' exists and this run's ledger does not account for it: delete it (git branch -D $branch) or resume the run it belongs to" >&2
      exit 14
    fi
    ensure_worktree
    reset_tracked
    defined=no
    if grep -q '^qa: flows defined' "$ledger"; then defined=yes; fi
    if branch_exists; then
      if [ "$(git -C "$wt" branch --show-current)" != "$branch" ]; then
        git -C "$wt" switch -q "$branch"
      fi
      # Before the flows are defined the branch holds nothing of its own, so
      # it follows a base that moved. Afterwards it is never moved.
      if [ "$defined" = no ] \
        && [ "$(git -C "$wt" rev-parse HEAD)" != "$(git -C "$main" rev-parse "refs/heads/$base")" ]; then
        git -C "$wt" reset -q --hard "refs/heads/$base"
      fi
    else
      git -C "$wt" switch -q -c "$branch" "refs/heads/$base"
    fi
    short=$(git -C "$wt" rev-parse --short HEAD)
    # 'next' asks for 'open' again after a skip or a landing, so the line is
    # recorded again then. A started pass keeps the line it was opened with.
    if [ "$defined" = no ]; then
      line="qa: opened — $branch at $short"
      last=$(grep -E '^(qa: opened|qa: skipped|batch [0-9]+: landed)' "$ledger" | tail -n 1 || true)
      if [ "$last" != "$line" ]; then
        printf '%s\n' "$line" >> "$ledger"
      fi
    fi
    echo "opened $short"
    ;;
esac
