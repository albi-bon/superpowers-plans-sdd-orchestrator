#!/usr/bin/env bash
# Decide whether a freshly scouted phase may build beside the phases already
# in flight, and record a hold in the ledger when it may not.
#
# Two signals hold phase N:
#   - PREREQ_PHASE: the scout's 'prereq-inflight' value. Grounding found a
#     prerequisite missing that phase M is building. Holds N until M merges,
#     unless M is already merged.
#   - File overlap: a path on N's brief 'Files:' lines that is also on an
#     in-flight phase's brief 'Files:' lines or in its branch diff against
#     base. Lockfiles never count; they are regenerated at integration. A path
#     ending in '/' matches everything under it.
#
# In flight means the status phase-state reports as active, verified,
# integrating or landable. Held, failed and merged phases are not compared
# against, so holds cannot form a cycle: the later of two clashing phases is
# always the one held.
#
# Prints 'clear', or 'held <M> <reason>' after appending
#   phase <N>: held — waits on phase <M> (<reason>)
# to the ledger. A clear result appends nothing.
#
# Usage: phase-overlap DESIGN_DOC BASE N [PREREQ_PHASE]
set -euo pipefail

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
  echo "usage: phase-overlap DESIGN_DOC BASE N [PREREQ_PHASE]" >&2
  exit 2
fi
doc=$1
base=$2
num=$3
prereq=${4:-none}
case "$num" in
  '' | *[!0-9]*) echo "phase number must be an integer" >&2; exit 2 ;;
esac

here=$(cd "$(dirname "$0")" && pwd)
rundir=$("$here/phase-run-dir" "$doc")
ledger="$rundir/run.md"
brief="$rundir/phase-$num-brief.md"
if [ ! -f "$brief" ]; then
  echo "no brief for phase $num at $brief: the scout must write it first" >&2
  exit 2
fi

state=$("$here/phase-state" "$doc")
status_of() {
  printf '%s\n' "$state" | awk -F'\t' -v n="$1" '$1 == n { print $2 }'
}

hold() {
  printf 'phase %s: held — waits on phase %s (%s)\n' "$num" "$1" "$2" >> "$ledger"
  printf 'held %s %s\n' "$1" "$2"
  exit 0
}

# --- the scout's in-flight prerequisite -------------------------------------

m=$(printf '%s' "$prereq" | tr '[:upper:]' '[:lower:]' | tr -cd '0-9')
if [ -n "$m" ] && [ "$m" != "$num" ] && [ "$(status_of "$m")" != "merged" ]; then
  hold "$m" "prereq-inflight"
fi

# --- file overlap ------------------------------------------------------------

# Paths from a brief's Files lines, one per line. Backticked tokens when the
# line has any; otherwise every word that looks like a path.
brief_paths() {
  [ -f "$1" ] || return 0
  awk '
    {
      l = $0
      sub(/^[[:space:]]+/, "", l)
      if (l !~ /^[-*][[:space:]]+\*\*Files:\*\*/) next
      sub(/^[-*][[:space:]]+\*\*Files:\*\*/, "", l)
      if (index(l, "`") > 0) {
        k = split(l, parts, "`")
        for (i = 2; i <= k; i += 2) if (parts[i] != "") print parts[i]
        next
      }
      gsub(/[,;()]/, " ", l)
      k = split(l, words, " ")
      for (i = 1; i <= k; i++) {
        w = words[i]
        sub(/[.:]+$/, "", w)
        if (w ~ /[A-Za-z0-9]/ && (index(w, "/") > 0 || w ~ /[A-Za-z0-9_-]\.[A-Za-z0-9]+$/)) print w
      }
    }
  ' "$1"
}

# Drop lockfiles and a leading ./, and de-duplicate.
normalise() {
  awk '
    {
      p = $0
      sub(/^\.\//, "", p)
      if (p == "") next
      b = p
      sub(/^.*\//, "", b)
      if (b == "package-lock.json" || b == "npm-shrinkwrap.json" || b == "pnpm-lock.yaml" \
        || b == "yarn.lock" || b == "bun.lockb" || b == "Cargo.lock" || b == "go.sum" \
        || b == "poetry.lock" || b == "uv.lock" || b == "Gemfile.lock" || b == "composer.lock") next
      if (!(p in seen)) { seen[p] = 1; print p }
    }
  '
}

mine=$(brief_paths "$brief" | normalise)
[ -n "$mine" ] || { echo clear; exit 0; }

others=$(printf '%s\n' "$state" | awk -F'\t' -v n="$num" '
  $1 != "run" && $1 != n && ($2 == "active" || $2 == "verified" || $2 == "integrating" || $2 == "landable") { print $1 }
')

for other in $others; do
  record=$("$here/parse-phases" "$doc" "$other")
  branch="phase-$other-$(printf '%s\n' "$record" | cut -f3)"
  theirs=$(
    {
      brief_paths "$rundir/phase-$other-brief.md"
      if git show-ref --verify --quiet "refs/heads/$branch" \
        && fork=$(git merge-base "$base" "$branch" 2>/dev/null); then
        git diff --name-only "$fork" "$branch"
      fi
    } | normalise
  )
  [ -n "$theirs" ] || continue
  clash=$(MINE=$mine THEIRS=$theirs awk '
    BEGIN {
      a = split(ENVIRON["MINE"], x, "\n")
      b = split(ENVIRON["THEIRS"], y, "\n")
      for (i = 1; i <= a; i++) for (j = 1; j <= b; j++) {
        p = x[i]; q = y[j]
        if (p == "" || q == "") continue
        if (p == q \
          || (substr(p, length(p)) == "/" && index(q, p) == 1) \
          || (substr(q, length(q)) == "/" && index(p, q) == 1)) { print p; exit }
      }
    }
  ')
  if [ -n "$clash" ]; then
    hold "$other" "overlap $clash"
  fi
done

echo clear
