#!/usr/bin/env bash
# Run the shared phase-run-dir under this skill's run-directory namespace, so the two
# skills in this repository never read or write each other's ledger. The
# namespace is set here rather than by the controller, which could forget it
# after its context is compacted. `pwd -P` resolves the installed skill
# symlink to this checkout, where shared/ lives.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd -P)
export PHASE_RUN_NAMESPACE=phase-orchestrator
exec "$here/../../../shared/scripts/phase-run-dir" "$@"
